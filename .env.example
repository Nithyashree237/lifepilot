# ---------------------------------------------------------------------------
# LifePilot configuration
# Copy this file to `.env` (same folder) and edit the values you need.
# Every value is optional: LifePilot runs fully offline with the defaults.
# ---------------------------------------------------------------------------

# --- Public demo -----------------------------------------------------------
# Auto-load the bundled samples and disable bulk deletion. Recommended for a
# public portfolio deployment.
# LIFEPILOT_DEMO_MODE=true

# --- Storage ---------------------------------------------------------------
# Folder for the SQLite database and uploaded files.
# Defaults to <project>/data
# LIFEPILOT_DATA_DIR=C:/Users/you/Downloads/data

# SQLAlchemy connection string. Defaults to a SQLite file inside DATA_DIR.
# Use an absolute path to avoid surprises when starting the app elsewhere.
# LIFEPILOT_DB_URL=sqlite:///C:/Users/you/Downloads/data/lifepilot.db
# PostgreSQL example:
# LIFEPILOT_DB_URL=postgresql+psycopg://lifepilot:secret@localhost:5432/lifepilot

# --- OCR binaries (only needed for scanned PDFs and images) ----------------
# LifePilot auto-detects the usual Windows install locations. Set these only
# if you installed the tools somewhere else.
# LIFEPILOT_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# LIFEPILOT_POPPLER_PATH=C:/tools/poppler/bin

# --- Optional LLM fallback (off unless enabled in Settings) ---------------
# Any OpenAI-compatible chat-completions endpoint works.
# LIFEPILOT_LLM_API_KEY=sk-...
# LIFEPILOT_LLM_BASE_URL=https://api.openai.com/v1
# LIFEPILOT_LLM_MODEL=gpt-4o-mini
# LIFEPILOT_LLM_TIMEOUT=45

# --- Optional email reminders ---------------------------------------------
# A digest is sent only when the scheduler creates a new reminder.
# Gmail: turn on 2-Step Verification, then create a 16-character App Password
# (Google Account -> Security -> App passwords). Your normal password will not work.
# LIFEPILOT_SMTP_HOST=smtp.gmail.com
# LIFEPILOT_SMTP_PORT=587
# LIFEPILOT_SMTP_USER=you@gmail.com
# LIFEPILOT_SMTP_PASSWORD=your-16-character-app-password
# LIFEPILOT_SMTP_FROM=you@gmail.com
# LIFEPILOT_SMTP_USE_TLS=true
# Use implicit TLS instead (port 465 providers):
# LIFEPILOT_SMTP_USE_SSL=true
# Recipient for digests and the Settings test button.
# LIFEPILOT_EMAIL_TO=you@gmail.com
# Start with reminder emails enabled on a fresh database.
# LIFEPILOT_EMAIL_ENABLED=true

# --- Reminder scheduler ----------------------------------------------------
# How often the in-app scheduler checks deadlines (hours).
# LIFEPILOT_REMINDER_CHECK_HOURS=6
