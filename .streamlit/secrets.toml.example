# Copy this file to `.streamlit/secrets.toml` for local testing, or paste the
# same TOML into Streamlit Community Cloud → App settings → Secrets.

# Public demo: auto-load samples and disable bulk deletion.
LIFEPILOT_DEMO_MODE = "true"

# Optional AI assist (leave empty on a public demo unless you want visitors to
# spend your API credits).
# LIFEPILOT_LLM_API_KEY = ""
# LIFEPILOT_LLM_BASE_URL = "https://api.openai.com/v1"
# LIFEPILOT_LLM_MODEL = "gpt-4o-mini"
