# Copy this file to `.streamlit/secrets.toml` for local testing, or paste the
# same TOML into Streamlit Community Cloud -> App settings -> Secrets.
# The file is git-ignored, so nothing here is published.

# Public demo: auto-load samples and disable destructive actions.
LIFEPILOT_DEMO_MODE = "true"

# --- Email reminders (recommended for a portfolio demo) --------------------
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
LIFEPILOT_SMTP_HOST = "smtp.gmail.com"
LIFEPILOT_SMTP_PORT = "587"
LIFEPILOT_SMTP_USER = "you@gmail.com"
LIFEPILOT_SMTP_PASSWORD = "your-16-character-app-password"
LIFEPILOT_SMTP_FROM = "you@gmail.com"
# Visitors cannot type arbitrary recipients in demo mode; this is the one
# address that receives test emails and reminder digests.
LIFEPILOT_EMAIL_TO = "you@gmail.com"
LIFEPILOT_EMAIL_ENABLED = "true"

# --- Optional AI assist ----------------------------------------------------
# Leave commented on a public demo unless you set a spending limit on the key.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Gemini, OpenRouter...).
# LIFEPILOT_LLM_API_KEY = "sk-..."
# LIFEPILOT_LLM_BASE_URL = "https://api.openai.com/v1"
# LIFEPILOT_LLM_MODEL = "gpt-4o-mini"
